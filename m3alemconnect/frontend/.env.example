# Copy this file to .env.local and fill in your own Supabase project values.
# Supabase dashboard -> Project Settings -> Data API (URL) and API Keys (publishable key).
# The publishable key is meant to be public: the database security rules protect the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
